# Discord Configuration
DISCORD_TOKEN=your-bot-token
DISCORD_GUILD_ID=your-server-id

# OpenAI Configuration
OPENAI_API_KEY=sk-your_api_key_here
GPT_MODEL=gpt-4-turbo-preview
GPT_MAX_TOKENS=4096

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=superbot
DB_PASSWORD=change_me
DB_NAME=superbot_dev
# Chỉ dùng bởi docker-compose (MYSQL_ROOT_PASSWORD), bot không đọc biến này
DB_ROOT_PASSWORD=change_me

# Application Configuration
APP_ENV=development
LOG_LEVEL=debug
PORT=8080
TIMEZONE=Asia/Ho_Chi_Minh

# Feature Flags

# Rate Limiting
RATE_LIMIT_EXPORT_PER_HOUR=10

# GPT Configuration
GPT_MAX_CONCURRENT_REQUESTS=3
GPT_REQUEST_TIMEOUT_SECONDS=90
GPT_DAILY_BUDGET_USD=10.0

# Development Settings
DEBUG_MODE=true
MOCK_GPT_API=true
